NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgres://user:password@host:port/database
REDIS_URL=redis://host:port
# Comma-separated allowed browser origins.
APP_ORIGIN=https://dashboard.example.com
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
PUBLIC_ASSET_BASE_URL=
ASSET_SIGNING_SECRET=change-me-minimum-32-characters
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
STORAGE_PUBLIC_PREFIX=public
STORAGE_PRIVATE_PREFIX=private
BACKUP_DIR=/absolute/private/backup/path
BACKUP_RETENTION_DAYS=7
METRICS_TOKEN=minimum-16-character-token
HEALTHCHECK_URL=https://api.example.com/api/v1/health/ready
METRICS_URL=https://api.example.com/api/v1/health/metrics
BACKUP_MAX_AGE_HOURS=26
HEALTHCHECK_TIMEOUT_SECONDS=10
ALERT_WEBHOOK_URL=
AUTH_OTP_SECRET=
OTP_DELIVERY_WEBHOOK_URL=
OTP_DELIVERY_TIMEOUT_MS=5000
META_WEBHOOK_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=
META_TOKEN_ENCRYPTION_KEY=
