{
  "name": "fcommerce-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "node scripts/migrate.mjs",
    "check": "npm run check:api-docs && npm run build && npm test",
    "check:api-docs": "node scripts/check-api-docs.mjs",
    "test": "npm run build && node test/onboarding.integration.mjs",
    "test:auth-db": "npm run build && node test/auth-db-smoke.mjs",
    "test:catalog-db": "npm run build && node test/catalog-db-smoke.mjs",
    "test:permissions-db": "npm run build && node test/permissions-db-smoke.mjs",
    "test:orders-db": "npm run build && node test/orders-db-smoke.mjs",
    "test:order-dashboard-db": "npm run build && node test/order-dashboard-db-smoke.mjs",
    "test:delivery-db": "npm run build && node test/delivery-db-smoke.mjs",
    "test:inbox-db": "npm run build && node test/inbox-db-smoke.mjs",
    "test:order-drafts-db": "npm run build && node test/order-drafts-db-smoke.mjs",
    "test:team-settings-db": "npm run build && node test/team-settings-db-smoke.mjs",
    "test:payments-db": "npm run build && node test/payments-db-smoke.mjs",
    "test:analytics-db": "npm run build && node test/analytics-db-smoke.mjs",
    "test:customers-db": "npm run build && node test/customers-db-smoke.mjs",
    "test:meta-db": "npm run build && node test/meta-db-smoke.mjs",
    "test:onboarding": "npm run build && node test/onboarding.integration.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.23.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
